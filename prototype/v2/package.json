{
  "name": "@uwflow/degree-planner-prototype",
  "private": true,
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "lint-nofix": "eslint . --ext .ts,.tsx --quiet",
    "lint": "eslint . --ext .ts,.tsx --quiet --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "bun run lint-nofix && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tippyjs/react": "^4.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.3",
    "react-helmet": "^6.0.0-beta",
    "react-modal": "^3.11.1",
    "react-router-dom": "^5.1.2",
    "tailwind-merge": "^2.6.0",
    "tippy.js": "^6.2.5"
  },
  "devDependencies": {
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.5",
    "@types/react-helmet": "6.1.11",
    "@types/react-modal": "3.16.3",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^7.1.0",
    "eslint-config-airbnb-typescript": "^15.0.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-import-resolver-typescript": "^2.0.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^5.0.3",
    "prettier": "^2.0.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "4.9.5",
    "vite": "5.4.21",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "babel-jest": "29.7.0",
    "@types/jest": "29.5.14",
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "postcss": "8.5.6",
    "autoprefixer": "10.4.22",
    "@types/node": "22.10.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/**/*.test.ts",
      "<rootDir>/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-react",
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/styleMock.js"
    }
  }
}
